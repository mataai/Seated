{
  "name": "docs",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "docs",
  "tags": ["type:app"],
  "implicitDependencies": ["core", "renderer", "viewer", "editor", "angular"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/snippets/**/*",
        "{projectRoot}/tsconfig.json",
        "^production"
      ],
      "options": {
        "command": "tsc -p docs/tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck"],
      "outputs": ["{projectRoot}/.vitepress/dist"],
      "options": {
        "command": "vitepress build docs"
      },
      "inputs": [
        "default",
        "^production",
        {
          "env": "DOCS_BASE"
        }
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress dev docs"
      }
    }
  }
}
