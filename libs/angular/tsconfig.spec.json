{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "moduleResolution": "bundler",
    "isolatedModules": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "tests/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
