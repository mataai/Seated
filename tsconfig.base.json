{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@open-seats/core": ["./libs/core/src/index.ts"],
      "@open-seats/renderer": ["./libs/renderer/src/index.ts"],
      "@open-seats/viewer": ["./libs/viewer/src/index.ts"],
      "@open-seats/editor": ["./libs/editor/src/index.ts"],
      "@open-seats/angular": ["./libs/angular/src/index.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "types": ["*"]
  },
  "exclude": ["node_modules", "tmp"]
}
